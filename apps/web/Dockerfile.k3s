# apps/web — air-gapped k2 cluster image (linux/amd64, node:20-slim per team
# convention). Next.js standalone output; build from the REPO ROOT:
#   docker build --platform=linux/amd64 -f apps/web/Dockerfile.k3s \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.example \
#     -t xcollab-web:latest .
#
# NEXT_PUBLIC_* are BUILD-time (inlined into client bundles): set them per
# target environment here, not at `docker run`.

FROM node:20-slim AS build
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ARG NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8081/realms/xcollab
ARG NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=xcollab-web
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_KEYCLOAK_ISSUER=${NEXT_PUBLIC_KEYCLOAK_ISSUER} \
    NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=${NEXT_PUBLIC_KEYCLOAK_CLIENT_ID} \
    NEXT_TELEMETRY_DISABLED=1
# Optional PEM bundle for TLS-intercepting corporate proxies (Zscaler et al.);
# empty default is a no-op. Build-stage only.
ARG EXTRA_CA=""
RUN printf '%s' "$EXTRA_CA" > /usr/local/share/extra-ca.pem
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/extra-ca.pem
WORKDIR /repo
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/core/package.json packages/core/
COPY packages/synthesizer/package.json packages/synthesizer/
COPY services/api/package.json services/api/
COPY services/ai-gateway/package.json services/ai-gateway/
COPY apps/web/package.json apps/web/
COPY eval-harness/package.json eval-harness/
RUN pnpm install --frozen-lockfile --filter "@xcollab/web..."

COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm --filter @xcollab/web build

FROM node:20-slim
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    NEXT_TELEMETRY_DISABLED=1
RUN useradd --uid 10001 --user-group --shell /usr/sbin/nologin xcollab
WORKDIR /app
# Monorepo standalone layout: server lives at apps/web/server.js under the
# tracing root; static assets and public/ are not traced, copy explicitly.
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
USER 10001
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
