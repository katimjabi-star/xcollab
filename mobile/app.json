{
  "expo": {
    "name": "XCollab",
    "slug": "xcollab",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "xcollab",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0F1216",
    "ios": {
      "bundleIdentifier": "com.katim.xcollab",
      "supportsTablet": true
    },
    "android": {
      "package": "com.katim.xcollab",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1216"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withXCollabNetwork.js",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "pinnedHosts": {
        "service8.nexedge.ae": "172.26.34.221"
      }
    }
  }
}
